<view class=\"container\">\n  <view class=\"category-bar\">\n    <scroll-view class=\"category-scroll\" scroll-x>\n      <block wx:for=\"{{categories}}\" wx:key=\"index\">\n        <view class=\"category-item {{activeCategory === index ? 'active' : ''}}\" \n              bindtap=\"selectCategory\" data-index=\"{{index}}\">\n          {{item}}\n        </view>\n      </block>\n    </scroll-view>\n  </view>\n\n  <view class=\"content\">\n    <block wx:if=\"{{loading}}\">\n      <view class=\"loading\">\n        <text>加载中...</text>\n      </view>\n    </block>\n\n    <block wx:else>\n      <view class=\"courses-grid\">\n        <block wx:for=\"{{courses}}\" wx:key=\"id\">\n          <view class=\"course-card\" bindtap=\"viewDetail\" data-id=\"{{item.id}}\">\n            <view class=\"course-image-wrapper\">\n              <image src=\"{{item.coverImage}}\" class=\"course-image\" mode=\"aspectFill\"></image>\n              <view class=\"course-type-badge\">{{item.type === 'VIDEO' ? '视频' : (item.type === 'LIVE' ? '直播' : '文章')}}</view>\n              <view class=\"course-duration\">⏱ {{item.duration}}</view>\n            </view>\n            \n            <view class=\"course-info\">\n              <view class=\"course-title\">{{item.title}}</view>\n              <view class=\"course-teacher\">讲师：{{item.teacher}}</view>\n              <view class=\"course-category\">{{item.category}}</view>\n              \n              <view class=\"course-stats\">\n                <view class=\"stat\">\n                  <text class=\"stat-icon\">👁</text>\n                  <text class=\"stat-value\">{{item.views}}</text>\n                </view>\n                <view class=\"stat\" bindtap=\"likeCourse\" data-id=\"{{item.id}}\">\n                  <text class=\"stat-icon\">❤️</text>\n                  <text class=\"stat-value\">{{item.likes}}</text>\n                </view>\n                <view class=\"stat\" bindtap=\"collectCourse\">\n                  <text class=\"stat-icon\">⭐</text>\n                  <text class=\"stat-value\">收藏</text>\n                </view>\n              </view>\n            </view>\n          </view>\n        </block>\n      </view>\n    </block>\n  </view>\n</view>\n