.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.content {
  flex: 1;
  overflow-y: auto;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background-color: #fff;
  border-bottom: 1px solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.logo {
  font-size: 18px;
  font-weight: bold;
  color: #00B26A;
}

.nav-right {
  display: flex;
  gap: 16px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  color: #666;
  padding: 6px 12px;
  background-color: #f5f5f5;
  border-radius: 20px;
}

.nav-icon {
  width: 16px;
  height: 16px;
}

/* 轮播图 */
.banner-swiper {
  width: 100%;
  height: 200px;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  bottom: 16px;
  left: 16px;
  color: #fff;
  font-size: 16px;
  font-weight: bold;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

/* 快速导航 */
.quick-nav {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin: 12px;
  padding: 12px;
}

.quick-nav .nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 12px;
  background-color: #f9f9f9;
  border-radius: 8px;
  font-size: 12px;
}

.nav-icon {
  font-size: 28px;
}

.nav-text {
  color: #333;
  font-weight: 500;
}

/* 分段标题 */
.section {
  margin-top: 12px;
  padding: 0 12px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 12px;
}

.see-more {
  font-size: 12px;
  color: #00B26A;
}

/* 老师列表 */
.teachers-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.teacher-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px 8px;
  text-align: center;
}

.teacher-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  margin-bottom: 8px;
}

.teacher-name {
  font-size: 12px;
  font-weight: bold;
  color: #333;
  margin-bottom: 4px;
}

.teacher-title {
  font-size: 11px;
  color: #00B26A;
  margin-bottom: 4px;
}

.teacher-intro {
  font-size: 10px;
  color: #999;
}

/* 旅居列表 */
.travel-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}

.travel-card {
  display: flex;
  gap: 12px;
  padding: 0;
  overflow: hidden;
}

.travel-image {
  width: 140px;
  height: 120px;
  flex-shrink: 0;
  border-radius: 8px 0 0 8px;
}

.travel-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 12px;
}

.travel-name {
  font-size: 14px;
  font-weight: bold;
  color: #333;
}

.travel-location {
  font-size: 12px;
  color: #666;
  margin-top: 4px;
}

.travel-footer {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

.travel-price {
  font-size: 14px;
  font-weight: bold;
  color: #ff6b3b;
  margin-top: 4px;
}

/* 课程网格 */
.courses-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.course-item {
  padding: 0;
  overflow: hidden;
}

.course-image {
  width: 100%;
  height: 120px;
  border-radius: 8px;
}

.course-title {
  font-size: 12px;
  font-weight: bold;
  color: #333;
  margin-top: 8px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-category {
  font-size: 11px;
  color: #00B26A;
  margin-top: 4px;
}

.course-views {
  font-size: 10px;
  color: #999;
  margin-top: 4px;
}

/* 学员风采 */
.members-scroll {
  display: flex;
  gap: 12px;
  white-space: nowrap;
  overflow-x: auto;
  padding-bottom: 8px;
}

.member-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  min-width: 100px;
  padding: 0 8px;
}

.member-image {
  width: 80px;
  height: 80px;
  border-radius: 50%;
}

.member-name {
  font-size: 12px;
  font-weight: bold;
  color: #333;
}

.member-feedback {
  font-size: 10px;
  color: #999;
  text-align: center;
  white-space: normal;
}

/* 产品网格 */
.products-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.product-item {
  padding: 0;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 140px;
  border-radius: 8px;
}

.product-name {
  font-size: 12px;
  font-weight: bold;
  color: #333;
  margin-top: 8px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  font-size: 13px;
  font-weight: bold;
  color: #ff6b3b;
  margin-top: 4px;
}

.product-sales {
  font-size: 10px;
  color: #999;
  margin-top: 4px;
}

/* 底部客服 */
.bottom-service {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  margin: 12px;
  padding: 20px;
  background: linear-gradient(135deg, #00B26A 0%, #00933d 100%);
  color: #fff;
  border-radius: 8px;
  text-align: center;
}

.service-icon {
  font-size: 32px;
}

.service-text {
  font-size: 13px;
}

.service-btn {
  width: 100%;
  padding: 10px;
  background-color: #fff;
  color: #00B26A;
  border-radius: 6px;
  font-size: 13px;
  font-weight: bold;
}
